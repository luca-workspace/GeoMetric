<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!--
        IMPORTANT: orientation="horizontal" is mandatory here.
        Without it the default is vertical, layout_weight on children
        has no effect horizontally, and tv_option_text collapses to 0dp.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <!-- Letter badge: A / B / C / D -->
        <TextView
            android:id="@+id/tv_option_letter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_option_letter"
            android:layout_marginEnd="12dp" />

        <!-- Answer text — takes all remaining width -->
        <TextView
            android:id="@+id/tv_option_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Answer"
            android:textSize="@dimen/text_option"
            android:textColor="@color/text_primary" />

        <!-- Result icon shown after answer (check / close) -->
        <ImageView
            android:id="@+id/iv_option_result"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>